{
  "manifest_version": 3,

  "name": "DigiWage Light Wallet",
  "description": "DigiWage Wallet Light for Chrome",
  "version": "0.1.0",

  "action": {
    "default_popup": "index.html",
    "default_title": "DigiWage Light Wallet"
  },
  "icons": {
    "16": "favicon.png",
    "48": "favicon.png",
    "128": "favicon.png"
  },
  "background": {
    "service_worker": "integration/background/index.js"
  },
    "content_scripts": [
      {
          "matches": [
              "file://*/*",
              "http://*/*",
              "https://*/*"
          ],
          "js": [
              "integration/contentScript/index.js"
          ],
          "run_at": "document_start",
          "all_frames": false
      }
  ],
  "web_accessible_resources": [
    {
      "resources": ["integration/inpage/index.js"],
      "matches": ["file://*/*", "http://*/*", "https://*/*"]
    }
  ],
  "permissions": [
    "storage",
    "unlimitedStorage",
    "clipboardWrite",
    "activeTab",
    "tabs",
    "sidePanel"
  ],
  "side_panel": {
    "default_path": "index.html"
  },
  "host_permissions": [
    "file://*/*",
    "http://*/*",
    "https://*/*"
  ]
}
